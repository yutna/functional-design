# macOS
.DS_Store

# Node, if markdownlint is ever installed locally instead of via npx
node_modules/
npm-debug.log*
.npm/

# Editors
.vscode/
.idea/
*.swp

# Deliberately NOT ignored: .markdownlint* config files.
# The brief forbids overriding markdownlint's defaults, and
# scripts/verify.sh fails the build if such a file exists. Ignoring
# them here would hide an accidental config instead of catching it.

# Local-only: SOURCES.md records the books this pack was built from.
# The published repository deliberately names no source, so this record
# is kept out of git rather than lost.
SOURCES.md

# Local-only: PRIVATE-NOTES.md holds the detail behind increment 5,
# which came from a client project. The published repository names no
# installation, so this record is kept out of git rather than lost.
PRIVATE-NOTES.md

# Python bytecode from importing scripts/ in a REPL
__pycache__/
